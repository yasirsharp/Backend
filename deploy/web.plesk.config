<?xml version="1.0" encoding="utf-8"?>
<!--
  Plesk (Windows) + MySQL test kurulumu için web.config. Ayrıntılı tarif: docs/PLESK_KURULUM.md
  BÜYÜK HARFLİ yer tutucuları (VERITABANI_ADI, ...) kendi bilgilerinizle değiştirin.
  Bu dosya parola içerir: Plesk Dosya Yöneticisi'nde başkasıyla paylaşmayın.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- Site açılmazsa (500.30 / 502.5) stdoutLogEnabled="true" yapın, logs\stdout_*.log dosyasına bakın, sonra tekrar kapatın -->
      <aspNetCore processPath="dotnet" arguments=".\API.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />

          <!-- Veritabanı: Plesk → Veritabanları'nda oluşturduğunuz MySQL veritabanı -->
          <environmentVariable name="Database__Provider" value="MySql" />
          <environmentVariable name="Database__MigrateOnStartup" value="true" />
          <environmentVariable name="ConnectionStrings__DefaultConnection" value="Server=localhost;Port=3306;Database=VERITABANI_ADI;User=VERITABANI_KULLANICISI;Password=VERITABANI_PAROLASI;" />

          <!-- Oturum (JWT) imza anahtarı. Değiştirirseniz herkesin oturumu kapanır. -->
          <environmentVariable name="TokenOptions__SecurityKey" value="GUVENLIK_ANAHTARI" />

          <!-- İlk yönetici: ilk girişten ve parola değiştirdikten sonra Seed__AdminPassword satırını silebilirsiniz -->
          <environmentVariable name="Seed__AdminEmail" value="YONETICI_EPOSTASI" />
          <environmentVariable name="Seed__AdminPassword" value="YONETICI_GECICI_PAROLASI" />
          <!-- Hata bildirimleri e-postası (isteğe bağlı). Doldurmazsanız bildirimler yalnızca Yönetim → Hata bildirimleri
               ekranında görünür. Plesk'te bir posta hesabı açıp bilgilerini yazın, sonra yorum işaretlerini kaldırın.
          <environmentVariable name="Email__Smtp__Host" value="mail.alanadiniz.com.tr" />
          <environmentVariable name="Email__Smtp__Port" value="465" />
          <environmentVariable name="Email__Smtp__Security" value="SslOnConnect" />
          <environmentVariable name="Email__Smtp__User" value="bildirim@alanadiniz.com.tr" />
          <environmentVariable name="Email__Smtp__Password" value="POSTA_PAROLASI" />
          <environmentVariable name="Email__Smtp__From" value="bildirim@alanadiniz.com.tr" />
          <environmentVariable name="BugReports__NotifyEmails" value="siz@alanadiniz.com.tr" />
          -->
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- Toplu içe aktarma istekleri için (2 MB) -->
          <requestLimits maxAllowedContentLength="2097152" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="X-Frame-Options" value="DENY" />
          <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
